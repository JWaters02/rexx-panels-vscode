{
  "name": "org-zowe-developer-tools",
  "displayName": "Zowe Developer Tools 4 Org",
  "publisher": "org",
  "private": true,
  "author": "Joshua Waters",
  "license": "EPL-2.0",
  "description": "Implments some org custom REXX panels to Zowe Explorer",
  "version": "1.3.0",
  "icon": "resources/compile.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "org-zowe-developer-tools.showExampleMenu",
        "title": "Example"
      },
      {
        "command": "org-zowe-developer-tools.clearWorkspaceState",
        "title": "Clear Workspace State"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "org-zowe-developer-tools.showExampleMenu",
          "when": "never"
        },
        {
          "command": "org-zowe-developer-tools.clearWorkspaceState"
        }
      ],
      "view/item/context": [
        {
          "when": "view == zowe.ds.explorer && viewItem =~ /^member.*/ && !listMultiSelection",
          "command": "org-zowe-developer-tools.showExampleMenu",
          "group": "000_zowe_dsMainframeInteraction@6"
        }
      ]
    }
  },
  "extensionDependencies": [
    "Zowe.vscode-extension-for-zowe"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-webviews",
    "lint": "eslint \"src/**/*.ts\"",
    "watch": "tsc -w -p ./",
    "package": "vsce package && move *.vsix vsix/",
    "copy-webviews": "copyfiles -u 1 src/webviews/**/* out"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "dependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.95.0",
    "@types/vscode-webview": "^1.57.0",
    "@zowe/imperative": "^8.10.3",
    "@zowe/zos-files-for-zowe-sdk": "^8.8.4",
    "@zowe/zos-jobs-for-zowe-sdk": "^8.8.4",
    "@zowe/zos-tso-for-zowe-sdk": "8.12.0",
    "@zowe/zowe-explorer-api": "^3.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  }
}
